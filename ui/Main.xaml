<DockPanel><Border DockPanel.Dock="Top" Background="#172B37" Padding="14,7"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Name="About" Background="Transparent" Padding="3" Margin="0,0,10,0" ToolTip="バージョンと仕様" AutomationProperties.Name="バージョンと仕様"><Image Name="Logo" Width="28" Height="28"/></Button><Menu VerticalAlignment="Center" Background="#172B37" Foreground="#B6C6CF"><MenuItem Header="ファイル" Foreground="#C3D1D9"><MenuItem Header="プロジェクトを追加" Tag="127" Foreground="Black"/><MenuItem Header="終了" Tag="exit" Foreground="Black"/></MenuItem><MenuItem Header="実行" Foreground="#C3D1D9"><MenuItem Header="AIに依頼" Tag="115" Foreground="Black"/><MenuItem Header="セッション履歴" Tag="190" Foreground="Black"/><MenuItem Header="KAGARI自身の改善" Tag="192" Foreground="Black"/><MenuItem Header="PowerShell" Tag="116" Foreground="Black"/><MenuItem Header="SHIRANUI ログ" Tag="log" Foreground="Black"/></MenuItem></Menu></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Grid><TextBox Name="Search" Width="175" Padding="7,4" ToolTip="タスク名で検索" VerticalContentAlignment="Center"/><TextBlock Name="SearchHint" Foreground="#536975" Text="タスク検索　 Ctrl＋F" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button Name="Layout" Content="&#xE89F;" FontFamily="Segoe MDL2 Assets" ToolTip="ペインのレイアウト"/><Button Name="SharedProgress" Tag="103" Content="共有進捗"/></StackPanel></DockPanel></Border>
<Border DockPanel.Dock="Left" Background="#203846" Padding="4,10"><StackPanel Name="Rail"/></Border>
<Grid Name="Workspace" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="205" MinWidth="0"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
