 <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="AutomationProperties.Name" Value="案件をピン留め"/><Setter Property="ToolTip" Value="案件をピン留め"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="AutomationProperties.Name" Value="ピン留めを解除"/><Setter Property="ToolTip" Value="ピン留めを解除"/></Trigger></Style.Triggers></Style></ToggleButton.Style>
 <Path Data="{StaticResource Jobs.Icon.pin}" Stroke="#096C65" Width="17" Height="17" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsJobPinned}" Value="True"><Setter Property="Fill" Value="#096C65"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></ToggleButton>
 </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="案件名 ／ 掲載サイト" Width="3*" MinWidth="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="7,0" VerticalAlignment="Center">
 <DockPanel>
