   <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsNewJob}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <TextBlock Text="新着" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
  </Border>
  <TextBlock Text="{Binding title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding title}"/>
 </DockPanel>
 <TextBlock Text="{Binding JobByline}" FontSize="13" Foreground="{StaticResource Jobs.muted}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTextColumn Header="報酬" Width="1.3*" Binding="{Binding JobPay,Mode=OneWay}" ElementStyle="{StaticResource JobsCell}"/>
 <DataGridTextColumn Header="期限" Width="100" Binding="{Binding JobShortDeadline,Mode=OneWay}" ElementStyle="{StaticResource JobsCell}"/>
 </DataGrid.Columns></DataGrid><TextBlock Name="JobsEmpty" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
 <GridSplitter Name="JobsGrip" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
 <Border Name="JobsDetail" Grid.Column="2" Style="{StaticResource JobsCard}" BorderThickness="1" BorderBrush="{StaticResource Jobs.border}">
 <DockPanel><DockPanel DockPanel.Dock="Top"><Button Name="JobsClose" DockPanel.Dock="Right" Content="×" AutomationProperties.Name="詳細を閉じる" ToolTip="詳細を閉じる"/><TextBlock Text="案件詳細" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
 <TextBlock Name="JobsDetailHint" Text="案件を選ぶと詳細を表示します。" DockPanel.Dock="Top" Margin="0,12" TextWrapping="Wrap"/>
 <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
 <Button Name="JobsLink" Content="掲載元で詳細を見る ↗" Style="{StaticResource PrimaryAction}"/>
 <ToggleButton Tag="JobPin" IsChecked="{Binding IsJobPinned,Mode=OneWay}" Padding="8,4" Margin="4,0" VerticalAlignment="Center">
 <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Content" Value="ピン留め"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="ピン留め解除"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton></WrapPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Name="JobsDetailScroll"><StackPanel Margin="2,8">
 <TextBlock Text="{Binding JobSite}" Foreground="{StaticResource Jobs.muted}"/><TextBlock Text="{Binding title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,8"/>
 <TextBlock Text="{Binding JobPay}" Foreground="{StaticResource Jobs.primary}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding JobFacts}" TextWrapping="Wrap" Margin="0,8"/><Separator/>
 <TextBlock Text="仕事内容" FontWeight="Bold" Margin="0,8"/><TextBlock Text="{Binding DisplayJobBody}" TextWrapping="Wrap"/>
 <TextBlock Text="{Binding JobSkills,StringFormat=記載スキル　{0}}" TextWrapping="Wrap" Foreground="{StaticResource Jobs.primary}" Margin="0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding JobSkills}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 <TextBlock Text="募集条件" FontWeight="Bold" Margin="0,8"/><TextBlock Text="{Binding significance}" TextWrapping="Wrap"/>

 </StackPanel></ScrollViewer></DockPanel></Border>
 </Grid></DockPanel></Border>
<Border Name="News" Visibility="Collapsed" Style="{StaticResource card}" Margin="10" Padding="18">
 <DockPanel Name="NewsRoot" Background="{StaticResource Surface}">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
    <TextBlock Text="収集担当" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox Name="NewsAgent" Width="80" Margin="0,0,8,0" AutomationProperties.Name="収集担当"/>
    <Button Name="NewsFetch" Style="{StaticResource PrimaryAction}"/>
   </WrapPanel>
   <TextBlock Text="AIニュース" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Expander DockPanel.Dock="Top" Header="収集設定・手動取り込み" Margin="0,0,0,8">
   <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
    <StackPanel Background="{StaticResource WorkspaceCanvas}" Margin="0,4,0,0">
     <WrapPanel Margin="10,8,8,0" Name="PatrolControls">
      <CheckBox Name="PatrolEnabled" Content="Museの毎日巡回（Windows）" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBlock Text="日本時間" VerticalAlignment="Center"/><TextBox Name="PatrolTime" Width="58" Margin="5,0,10,0" AutomationProperties.Name="巡回時刻（日本時間）"/>
      <TextBlock Text="DotsはCodexの自動化で設定" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <Button Name="PatrolSave" Content="巡回設定を保存" Margin="8,0"/><TextBlock Name="PatrolNext" VerticalAlignment="Center"/>
     </WrapPanel>
     <Grid Margin="10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="登録ソース（1行に1つのURL）"/><TextBox Name="NewsSources" AcceptsReturn="True" Height="66" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="登録ソース"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="収集サービスのAPI接続先（任意）"/><TextBox Name="NewsEndpoint" AutomationProperties.Name="API接続先"/><TextBlock Text="Slackで依頼する場合は空欄" Foreground="{StaticResource TextSecondary}" FontSize="12"/></StackPanel>
     </Grid>
     <WrapPanel Margin="8,0,8,6"><Button Name="NewsSave" Content="設定を保存"/><Button Name="NewsCopy" Content="依頼をコピー"/><Button Name="NewsPaste" Content="結果JSONを取り込む"/><Button Name="NewsStop" Content="返信の確認を終了"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>
  </Expander>
  <TextBlock Name="NewsStatus" DockPanel.Dock="Top" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="13"/>
  <TabControl Name="NewsTabs" DockPanel.Dock="Top" Margin="0,8,0,0" AutomationProperties.Name="ニュースの分類">
   <TabControl.Template><ControlTemplate TargetType="TabControl">
    <Border BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1" Padding="0,1,0,5">
     <WrapPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
    </Border>
   </ControlTemplate></TabControl.Template>
   <TabControl.ItemContainerStyle><Style TargetType="TabItem">
    <Setter Property="Margin" Value="0,0,3,3"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border Name="TabSurface" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Background="Transparent" Padding="8,5" MinHeight="34">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Name="TabLabel" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
       <Border Name="UnreadBadge" CornerRadius="10" Margin="6,0,0,0" MinWidth="20" Padding="5,1" Background="{StaticResource Selection}">
        <TextBlock Name="UnreadCount" Text="{TemplateBinding Header}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ActionPrimary}" HorizontalAlignment="Center"/>
       </Border>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="Header" Value="{x:Null}"><Setter TargetName="UnreadBadge" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource WorkspaceCanvas}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource ActionPrimary}"/><Setter TargetName="TabLabel" Property="Foreground" Value="White"/><Setter TargetName="TabLabel" Property="FontWeight" Value="SemiBold"/><Setter TargetName="UnreadBadge" Property="Background" Value="White"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource FocusRing}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></TabControl.ItemContainerStyle>
  </TabControl>
  <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="220"/><ColumnDefinition Width="3*" MinWidth="280"/></Grid.ColumnDefinitions>
   <Border Background="#F6F5F2" CornerRadius="8" Padding="10">
    <DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Name="NewsCount" TextWrapping="Wrap" FontWeight="SemiBold" Margin="4,2,4,6"/>
      <Button Name="NewsMarkTabRead" Style="{StaticResource PrimaryAction}" FontWeight="SemiBold" HorizontalAlignment="Stretch" MinHeight="38">
       <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/></DataTemplate></Button.ContentTemplate>
      </Button></StackPanel>
     <StackPanel Name="NewsPager" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
      <Button Name="NewsPrevPage" Content="前へ" AutomationProperties.Name="前のページ"/>
      <TextBlock Name="NewsPageNumber" VerticalAlignment="Center" Margin="8,0"/>
      <Button Name="NewsNextPage" Content="次へ" AutomationProperties.Name="次のページ"/>
     </StackPanel>
     <ListBox Name="NewsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="記事一覧">
      
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Name="Tile" Padding="11,8" Background="White" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EAF2F0"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource Selection}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource ActionPrimary}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource FocusRing}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Byline}" FontSize="12" Foreground="{StaticResource TextSecondary}"/><TextBlock Name="NewsHeadline" Text="{Binding title}" Margin="0,3,0,0" TextWrapping="Wrap" FontWeight="Normal"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding IsUnread}" Value="True"><Setter TargetName="NewsHeadline" Property="FontWeight" Value="Bold"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="20,0,2,0">
    <TextBlock Name="NewsEmpty" Text="収集した記事はここに表示されます。" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
    <DockPanel Name="NewsArticle">
     <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Name="NewsOpen" Content="原文を開く" Style="{StaticResource PrimaryAction}"/><Button Name="NewsTask" Content="タスク化…" Margin="8,0"/></WrapPanel>
     <ScrollViewer Name="NewsScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,10,8">
      <ComboBox Name="NewsVariant" DisplayMemberPath="Byline" AutomationProperties.Name="統合した記事の出典を切り替え" Margin="0,0,0,6"/>
      <TextBlock Text="{Binding Byline}" Foreground="{StaticResource ActionPrimary}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,16"/>
      <TextBlock Text="要約" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding summary}" FontSize="16" TextWrapping="Wrap" Margin="0,5,0,16"/>
      <Border Background="{StaticResource Selection}" Padding="12" CornerRadius="6"><StackPanel><TextBlock Text="重要な理由" FontWeight="SemiBold"/><TextBlock Text="{Binding significance}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <TextBlock Text="出典" Style="{StaticResource SectionHeading}" Margin="0,18,0,4"/>
      <TextBlock TextWrapping="Wrap" Margin="0,2"><Hyperlink NavigateUri="{Binding url, Mode=OneWay}" AutomationProperties.Name="原文URL"><Run Text="{Binding url, Mode=OneWay}"/></Hyperlink></TextBlock>
      <StackPanel Name="NewsRegistered"><TextBlock Text="登録ソース" Margin="0,8,0,2" Foreground="{StaticResource TextSecondary}"/><TextBlock TextWrapping="Wrap" Margin="0,2"><Hyperlink NavigateUri="{Binding source, Mode=OneWay}" AutomationProperties.Name="登録元URL"><Run Text="{Binding source, Mode=OneWay}"/></Hyperlink></TextBlock></StackPanel>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</Border>
