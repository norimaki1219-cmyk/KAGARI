 <Style x:Key="card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="{StaticResource Separator}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14"/></Style>
