 <DockPanel>
  <DockPanel DockPanel.Dock="Top"><Button Name="AnalyticsRefresh" Content="↻ 更新" DockPanel.Dock="Right"/><Button Name="SharedProgress" Tag="103" Content="共有目標・進捗の詳細を見る" DockPanel.Dock="Right" Margin="0,0,6,0" ToolTip="共有ダッシュボードの目標・期限と作業ごとの状況を表示"/><TextBlock Text="KPI分析" Style="{StaticResource SectionHeading}"/></DockPanel>
  <TextBlock Name="AnalyticsTime" DockPanel.Dock="Top" Margin="0,6,0,8" Foreground="{StaticResource TextSecondary}"/>
