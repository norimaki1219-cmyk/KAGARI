<DockPanel><Border DockPanel.Dock="Top" Background="#172B37" Padding="14,7"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Image Name="Logo" Width="28" Height="28"/><TextBlock Text="KAGARI" FontFamily="Segoe UI Semibold" Foreground="White" FontSize="19" Margin="9,0,22,0" VerticalAlignment="Center"/><Menu VerticalAlignment="Center" Background="#172B37" Foreground="#B6C6CF"><MenuItem Header="ファイル" Foreground="#C3D1D9"><MenuItem Header="プロジェクトを追加" Tag="127" Foreground="Black"/><MenuItem Header="終了" Tag="exit" Foreground="Black"/></MenuItem><MenuItem Header="実行" Foreground="#C3D1D9"><MenuItem Header="AIに依頼" Tag="115" Foreground="Black"/><MenuItem Header="セッション履歴" Tag="190" Foreground="Black"/><MenuItem Header="KAGARI自身の改善" Tag="192" Foreground="Black"/><MenuItem Header="PowerShell" Tag="116" Foreground="Black"/><MenuItem Header="SHIRANUI ログ" Tag="log" Foreground="Black"/></MenuItem></Menu></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Grid><TextBox Name="Search" Width="175" Padding="7,4" ToolTip="タスク名で検索" VerticalContentAlignment="Center"/><TextBlock Name="SearchHint" Foreground="#536975" Text="タスク検索　 Ctrl＋F" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button Name="Layout" Content="&#xE89F;" FontFamily="Segoe MDL2 Assets" ToolTip="ペインのレイアウト"/><Button Tag="103" Content="共有進捗"/></StackPanel></DockPanel></Border>
<Border DockPanel.Dock="Left" Background="#203846" Padding="4,10"><StackPanel Name="Rail"/></Border>
<Grid Name="Workspace" Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="205" MinWidth="0"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Name="Side" Style="{StaticResource card}" Padding="8"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="4,2,0,9"><Button DockPanel.Dock="Right" Tag="127" Content="＋" ToolTip="プロジェクトを追加"/><TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="エクスプローラー"/></DockPanel><Button Name="Register" DockPanel.Dock="Bottom" Content="選択フォルダーを登録"/><TreeView Name="Tree" BorderThickness="0" HorizontalContentAlignment="Stretch"/></DockPanel></Border>
<GridSplitter Name="SideGrip" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Name="Kpi" Style="{StaticResource card}" Margin="0,0,0,7"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Name="ProjectLabel" DockPanel.Dock="Right" Foreground="#52717C"/><TextBlock Text="部署別の進捗" FontSize="17" FontWeight="SemiBold"/></DockPanel><UniformGrid Name="Metrics" DockPanel.Dock="Bottom" Columns="4" Margin="0,7,0,0"/><ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto"><StackPanel Name="Chart"/></ScrollViewer></DockPanel></Border>
<Grid Grid.Row="1" Name="Panes"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
<Border Name="Queue" Style="{StaticResource card}"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Tag="113" Content="＋ 新規"/><TextBlock Text="作業キュー" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><WrapPanel DockPanel.Dock="Top"><ComboBox Name="Agent" DockPanel.Dock="Top" Margin="0,0,0,10" HorizontalAlignment="Left" Width="118"/><Button Name="ResetFilters" Tag="709" Padding="7,3" VerticalAlignment="Top" Content="絞り込みを解除"/></WrapPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,7,0,0"><Button Name="Ask" Tag="115" Content="AIに依頼" Background="#176D71" Foreground="White"/><Button Name="Advance" Tag="156" Content="作業を開始"/><Button Name="Pin" Tag="159" Content="☆" ToolTip="ピン留め・解除"/><Button Name="Details" Tag="160" Content="詳細"/></WrapPanel><Grid><ListBox Name="Tasks" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Name="Empty" Text="表示するタスクがありません" Foreground="#657985" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/><Button Name="EmptyAction" Margin="4,10" HorizontalAlignment="Center"/></StackPanel></Grid></DockPanel></Border>
<GridSplitter Name="Grip" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CFDADD" ResizeBehavior="PreviousAndNext"/>
<Border Name="Docs" Grid.Column="2" Style="{StaticResource card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="タスク資料" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/><WrapPanel DockPanel.Dock="Top" Name="Tabs"/><Button DockPanel.Dock="Bottom" Name="Attach" Tag="181" Content="タスクに関連付け"/><TextBlock DockPanel.Dock="Top" Name="FileName" Foreground="#637985" Margin="2,7" TextTrimming="CharacterEllipsis"/><RichTextBox Name="Preview" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></DockPanel></Border>
</Grid></Grid></Grid></DockPanel></Window>
