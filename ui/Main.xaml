<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KAGARI — ワークスペース" Width="1220" Height="792" MinWidth="810" MinHeight="560" WindowStartupLocation="CenterScreen" FontFamily="Yu Gothic UI" FontSize="13" Background="#F2F4F6" Foreground="#1D303B" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Padding" Value="11,6"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="#E8EEF0"/><Setter Property="Foreground" Value="#253C48"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".80"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#EC996A"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="#D7DFE3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14"/></Style>
