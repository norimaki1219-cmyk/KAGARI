<GridSplitter Name="SideGrip" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Name="Kpi" Style="{StaticResource card}" Margin="0,0,0,7"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Name="ProjectLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#52717C"/><TextBlock Text="プロジェクト別の進捗" Style="{StaticResource SectionHeading}"/></DockPanel><UniformGrid Name="Metrics" DockPanel.Dock="Bottom" Columns="4" Margin="0,7,0,0"/><DockPanel><WrapPanel Name="ChartLegend" DockPanel.Dock="Top"/><ScrollViewer MaxHeight="165" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><WrapPanel Name="Chart"/></ScrollViewer></DockPanel></DockPanel></Border>
<Grid Grid.Row="1" Name="Panes"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
<Border Name="Queue" Style="{StaticResource card}"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Name="NewTask" DockPanel.Dock="Right" Tag="113" Content="新規" Background="#D9EAF6" Foreground="#174F73"/><TextBlock Text="作業キュー" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/></DockPanel><WrapPanel DockPanel.Dock="Top"><WrapPanel Name="AgentFilters" Margin="0,0,0,8" VerticalAlignment="Center"/><Button Name="ResetFilters" Tag="709" Padding="7,3" VerticalAlignment="Top" Content="絞り込みを解除"/></WrapPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,7,0,0"><Button Name="Ask" ToolTip="依頼内容を入力する画面を開く" Tag="115" Content="タスク詳細・依頼" Style="{StaticResource PrimaryAction}"/><Button Background="#DDEFE4" Foreground="#205C3A" Name="Advance" ToolTip="選択中のタスクを、ボタンに表示された状態に変更する" Tag="156" Content="作業を開始"/><Button Name="Pin" Tag="159" Content="☆" ToolTip="選択中のタスクを作業キューの上部に固定する・固定を解除する"/><Button Name="Details" Visibility="Collapsed" ToolTip="タスクのサマリ、設定、依頼履歴を確認する" Tag="160" Content="詳細"/></WrapPanel><Grid><ListBox Name="Tasks" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/><StackPanel Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Name="Empty" Text="表示するタスクがありません" Foreground="#657985" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/><Button Name="EmptyAction" Margin="4,10" HorizontalAlignment="Center"/></StackPanel></Grid></DockPanel></Border>
<GridSplitter Name="Grip" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#CFDADD" ResizeBehavior="PreviousAndNext"/>
<Border Name="Docs" Grid.Column="2" Style="{StaticResource card}"><DockPanel><DockPanel DockPanel.Dock="Top"><Button Name="OpenDocument" DockPanel.Dock="Right" Content="Markdownを開く"/><TextBlock Text="タスク資料" Style="{StaticResource SectionHeading}" Margin="0,0,0,9"/></DockPanel><WrapPanel DockPanel.Dock="Top" Name="Tabs"/><Button DockPanel.Dock="Bottom" Name="Attach" Tag="181" Content="タスクに関連付け"/><TextBlock DockPanel.Dock="Top" Name="FileName" Foreground="#637985" Margin="2,7" TextTrimming="CharacterEllipsis"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel Name="DocumentOutline" Visibility="Collapsed"><TextBlock DockPanel.Dock="Top" Text="目次" FontWeight="SemiBold" Margin="4,0,4,4"/><ListBox Name="DocumentHeadings" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/></DockPanel><RichTextBox Grid.Column="1" Name="Preview" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"/><ScrollViewer Grid.ColumnSpan="2" Name="ExplorerPreview" Visibility="Collapsed" Background="White" Padding="4" VerticalScrollBarVisibility="Auto"/></Grid></DockPanel></Border>
</Grid></Grid></Grid></DockPanel></Window>
