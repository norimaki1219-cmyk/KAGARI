    <ComboBox Name="GoalDirection" SelectedIndex="0" Margin="0,5,10,5" AutomationProperties.Name="目標条件"><ComboBoxItem Content="以下"/><ComboBoxItem Content="以上"/></ComboBox>
    <TextBlock Text="次回確認日" VerticalAlignment="Center"/><DatePicker Name="GoalDate" Margin="5" AutomationProperties.Name="次回確認日"/>
   </WrapPanel>
  <TextBlock DockPanel.Dock="Top" Name="KpiHistoryNotice" Foreground="#8A461C" TextWrapping="Wrap"/>
  <WrapPanel Name="AnalyticsMetrics" DockPanel.Dock="Top" Margin="0,8,0,14"/>
  <TabControl><TabItem Header="集計"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8"><RadioButton Name="AnalyticsProject" GroupName="KpiGroups" Content="プロジェクト別" IsChecked="True" Margin="0,0,18,0"/><RadioButton Name="AnalyticsAgent" GroupName="KpiGroups" Content="担当AI別"/></StackPanel>
  <WrapPanel Name="AnalyticsLegend" DockPanel.Dock="Top" Margin="2,0,0,8"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><StackPanel Name="AnalyticsProjects"/><WrapPanel Name="AnalyticsPies" Visibility="Collapsed"/></Grid></ScrollViewer></DockPanel></TabItem>
  <TabItem Name="KpiTrendTab" Header="推移・改善"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
   <TextBlock Name="KpiEffect" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <WrapPanel><ComboBox Name="KpiScope" MinWidth="150" Margin="0,0,8,0" AutomationProperties.Name="分析対象"/><WrapPanel Name="KpiTrendLegend" VerticalAlignment="Center"/></WrapPanel>
   <Canvas Name="KpiPlot" Height="216" ClipToBounds="True" Margin="0,8"/>
   <WrapPanel><TextBlock Text="観測日時" VerticalAlignment="Center"/><ComboBox Name="KpiObservation" MinWidth="180" Margin="8,0" AutomationProperties.Name="詳細を表示する観測日時"/></WrapPanel>
   <TextBlock Name="KpiObservationDetail" TextWrapping="Wrap" Margin="0,6,0,14"/>
   <WrapPanel Margin="0,0,0,8"><TextBlock Text="基準時点" VerticalAlignment="Center"/><ComboBox Name="KpiBaseline" MinWidth="180" Margin="8,0" AutomationProperties.Name="基準時点"/></WrapPanel>
   <TextBlock Name="KpiComparison" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Name="KpiChanges" TextWrapping="Wrap" Margin="0,6"/>
   <TextBlock Name="KpiNotes" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
   <TextBlock Name="KpiGoalReview" TextWrapping="Wrap" Margin="0,8"/>
